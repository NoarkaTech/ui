{
  "name": "@noarka/cli",
  "version": "0.1.7",
  "description": "Scaffold Noarka UI primitives into your project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "noarka": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "noarka",
    "ui",
    "cli",
    "scaffold",
    "components"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noarka/ui": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.3.5",
    "typescript": "^5"
  }
}
